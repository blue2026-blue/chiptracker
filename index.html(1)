// 使用 TDCC 開放資料 API
async function fetchTDCC(stockNo) {
  // 取得最近兩週的股權分散資料
  const url = `https://www.tdcc.com.tw/smWeb/QryStock.jsp?scaDate=&SqlMethod=&StockNo=${stockNo}&StockName=&query=qryStock`;
  // 因為 TDCC 直接 API 需要處理 CORS，改用 Claude AI 輔助解析
  // 實際上使用 allproxy 或 TDCC opendata
  try {
    // 嘗試 TDCC opendata CSV
    const dates = getTDCCDates();
    const thisWeek = dates[0];
    const lastWeek = dates[1];

    const [r1, r2] = await Promise.all([
      fetchTDCCOpenData(stockNo, thisWeek),
      fetchTDCCOpenData(stockNo, lastWeek)
    ]);
    return { thisWeek: r1, lastWeek: r2, date: thisWeek };
  } catch(e) {
    return null;
  }
}

function getTDCCDates() {
  // 集保所每週五更新，計算最近兩個週五日期
  const today = new Date();
  const dates = [];
  let d = new Date(today);
  let count = 0;
  while(count < 2) {
    d.setDate(d.getDate() - 1);
    if(d.getDay() === 5) { // 週五
      const y = d.getFullYear();
      const m = String(d.getMonth()+1).padStart(2,'0');
      const dd = String(d.getDate()).padStart(2,'0');
      dates.push(`${y}${m}${dd}`);
      count++;
    }
  }
  return dates;
}

async function fetchTDCCOpenData(stockNo, dateStr) {
  // TDCC 開放資料 CSV 格式
  // https://www.tdcc.com.tw/portal/zh/smWeb/qryStock
  // 實際可用端點：opendata.tdcc.com.tw
  const url = `https://opendata.tdcc.com.tw/getOD.ashx?id=1-5&key=anonymous`;
  // 備用: 使用 TDCC 的另一個格式
  // 因為 CORS 限制，我們使用 fetch with no-cors 或代理
  // 這裡使用最新可用的公開端點
  const resp = await fetch(
    `https://www.tdcc.com.tw/portal/zh/smWeb/qryStock?StockNo=${stockNo}&StockName=&SqlMethod=StockNo&scaDate=${dateStr}&query=qryStock`,
    { mode: 'no-cors' }
  );
  // no-cors 無法讀取內容，需要其他方法
  throw new Error('CORS restricted');
}

