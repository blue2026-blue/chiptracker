// ── SIGNAL ──
function getSig(s) {
  const d = +(s.big - s.prev).toFixed(2);
  const diff = s.big - s.small;
  if(d>=1.5 && s.streak>=3 && diff>5) return {k:'strong',l:'強力買入',c:'ss'};
  if(d>=1.0)                          return {k:'alert', l:'⚡+1%提醒',c:'sa'};
  if(d>=0.5 && s.streak>=2)           return {k:'mid',   l:'持續增倉',c:'sm'};
  if(d>0 && s.streak>=1)              return {k:'watch', l:'初步關注',c:'sw'};
  if(d<-1)                            return {k:'down',  l:'⚠ 警示', c:'sd'};
  return {k:'neutral',l:'觀望中',c:'sn'};
}

function cCard(k){ return k==='strong'?'cs':k==='alert'?'ca':k==='down'?'cw':k==='mid'||k==='watch'?'cm':''; }

function hbars(h) {
  if(!h||h.length<2) return '';
  const vals = h.slice(-8);
  const mn=Math.min(...vals), mx=Math.max(...vals), rng=mx-mn||1;
  return vals.map((v,i)=>{
    const ht=Math.max(2,Math.round(((v-mn)/rng)*16)+2);
    const c=i===0?'fl':v>=vals[i-1]?'up':'dn';
    return `<div class="hb ${c}" style="height:${ht}px"></div>`;
  }).join('');
}

