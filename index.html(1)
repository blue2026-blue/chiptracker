    const dCls=d>=1?'warn':d>=0?'green':'red';
    return `
    <div class="card ${cCard(sig.k)}">
      <div class="ctop">
        <div class="cid">
          <span class="ccode">${s.code} · ${s.market||'上市'}</span>
          <span class="cname">${s.name}</span>
          ${s.note?`<span class="cnote">${s.note}</span>`:''}
        </div>
        <span class="csig ${sig.c}">${sig.l}</span>
      </div>
      <div class="cbar"><div class="cbar-fill" style="width:${Math.min(100,s.big)}%;background:${d>=1?'var(--warn)':d>=0?'var(--bull)':'var(--bear)'}"></div></div>
      <div class="cmets">
        <div class="met"><div class="ml">大戶%</div><div class="mv blue">${s.big.toFixed(2)}</div></div>
        <div class="met"><div class="ml">週變化</div><div class="mv ${dCls}">${dStr}</div></div>
        <div class="met"><div class="ml">散戶%</div><div class="mv gray">${s.small.toFixed(2)}</div></div>
        <div class="met"><div class="ml">大-散差</div><div class="mv ${diff>=0?'green':'red'}">${diff>=0?'+':''}${diff}</div></div>
        <div class="met"><div class="ml">連增週</div><div class="mv orange">${s.streak}週</div></div>
        <div class="met"><div class="ml">股價</div><div class="mv">${s.price||'—'}</div></div>
        <div class="met" style="grid-column:span 2"><div class="ml">歷史趨勢</div><div class="hbars">${hbars(s.history)}</div></div>
      </div>
      <div class="cacts">
        <button class="cact edit" onclick="openEdit(${idx})">✏️ 更新數據</button>
        <button class="cact del" onclick="delStock(${idx})">🗑 刪除</button>
      </div>
    </div>`;
  }).join('');
}

// ── FILTER ──
function setFilter(f, el) {
  filter = f;
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderCards();
}

// ── MODAL ──
function openAdd(){
  document.getElementById('ei').value=-1;
  document.getElementById('modal-title').textContent='＋ 新增追蹤標的';
  document.getElementById('msave').textContent='新增';
  ['f-code','f-name','f-big','f-prev','f-small','f-price','f-streak','f-note'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('f-market').value='上市';
  document.getElementById('modal').classList.add('open');
}
function openEdit(idx){
  const s=stocks[idx];
  document.getElementById('ei').value=idx;
  document.getElementById('modal-title').textContent=`✏️ 更新 ${s.name}`;
  document.getElementById('msave').textContent='更新';
  document.getElementById('f-code').value=s.code;
  document.getElementById('f-name').value=s.name;
  document.getElementById('f-big').value=s.big;
  document.getElementById('f-prev').value=s.prev;
  document.getElementById('f-small').value=s.small;
  document.getElementById('f-price').value=s.price||'';
  document.getElementById('f-streak').value=s.streak;
  document.getElementById('f-market').value=s.market||'上市';
  document.getElementById('f-note').value=s.note||'';
  document.getElementById('modal').classList.add('open');
}
function closeModal(){ document.getElementById('modal').classList.remove('open'); }

function saveStock(){
  const idx=parseInt(document.getElementById('ei').value);
  const code=document.getElementById('f-code').value.trim();
  const name=document.getElementById('f-name').value.trim();
  const big=parseFloat(document.getElementById('f-big').value);
  const prev=parseFloat(document.getElementById('f-prev').value);
  const small=parseFloat(document.getElementById('f-small').value)||0;
  const price=parseFloat(document.getElementById('f-price').value)||0;
  const streak=parseInt(document.getElementById('f-streak').value)||1;
  const market=document.getElementById('f-market').value;
  const note=document.getElementById('f-note').value.trim();

  if(!code||!name||isNaN(big)||isNaN(prev)){showToast('⚠️ 請填寫代號、名稱及大戶持股%');return;}

  if(idx===-1){
    stocks.push({code,name,market,big,prev,small,price,streak,note,history:[prev,big]});
    showToast(`✅ 已新增 ${name}`);
  } else {
    const s=stocks[idx];
    Object.assign(s,{code,name,market,big,prev,small,price,streak,note});
    if(!s.history) s.history=[];
    if(s.history[s.history.length-1]!==big) s.history.push(big);
    if(s.history.length>12) s.history.shift();
    showToast(`✅ 已更新 ${name}`);
  }
  save(); closeModal(); render();
}

function delStock(idx){
  if(!confirm(`確定移除 ${stocks[idx].name}（${stocks[idx].code}）？`)) return;
  const name=stocks[idx].name;
  stocks.splice(idx,1);
  save(); render();
  showToast(`🗑 已移除 ${name}`);
}

// ── ALERTS ──
function checkAlerts(){
  renderSummary();
  const a=stocks.filter(s=>(s.big-s.prev)>=1);
  if(a.length===0){showToast('✓ 本週沒有超過+1%的標的');return;}
  if('Notification' in window && Notification.permission==='granted'){
    a.forEach(s=>new Notification(`⚡ ${s.name}(${s.code}) 大戶增倉`,{body:`週增 +${(s.big-s.prev).toFixed(2)}%，目前 ${s.big.toFixed(2)}%`,icon:'./icon-192.png'}));
  }
  showToast(`🔔 ${a.length} 檔大戶增幅超過+1%`);
}

// ── EXPORT ──
function doExport(){
  const csv=['代號,名稱,上市櫃,大戶%,上週%,散戶%,週變化,連增週,股價,備註']
    .concat(stocks.map(s=>{
      const d=(s.big-s.prev).toFixed(2);
      return `${s.code},${s.name},${s.market||'上市'},${s.big},${s.prev},${s.small},${d},${s.streak},${s.price},"${s.note||''}"`;
    })).join('\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url; a.download=`籌碼追蹤_${new Date().toLocaleDateString('zh-TW')}.csv`;
  a.click();
  showToast('📤 已匯出 CSV');
}

// ── PAGE ──
function switchPage(p){
  document.querySelectorAll('.page').forEach(e=>e.classList.remove('active'));
  document.querySelectorAll('.ni').forEach(e=>e.classList.remove('active'));
  document.getElementById('page-'+p).classList.add('active');
  document.getElementById('ni-'+p).classList.add('active');
}

// ── TOAST ──
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}

// ── CLOSE ON BACKDROP ──
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
document.getElementById('scanModal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});

render();
</script>
</body>
