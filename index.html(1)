async function queryStockChip(stockCode, stockName) {
  showSrchProg(10);
  try {
    // 使用 Anthropic API 來查詢並解析集保所資料
    const prompt = `你是台灣股市籌碼分析助手。

請查詢以下股票在集保所（TDCC）股權分散表中，「持股1000張以上」的大戶合計持股比例：
股票代號：${stockCode}
股票名稱：${stockName || ''}

資料來源：https://www.tdcc.com.tw/portal/zh/smWeb/qryStock

請回傳以下 JSON 格式（只回傳 JSON，不要其他文字）：
{
  "code": "${stockCode}",
  "name": "公司名稱",
  "market": "上市或上櫃",
  "thisWeekDate": "最新資料日期(YYYYMMDD)",
  "thisWeekBig": 最新大戶持股百分比(數字),
  "lastWeekDate": "上週資料日期(YYYYMMDD)",
  "lastWeekBig": 上週大戶持股百分比(數字),
  "smallHolder": 散戶持股百分比(數字),
  "delta": 本週與上週差值(數字),
  "note": "簡短說明"
}

注意：大戶＝持股1000張以上的合計比例。如果無法查詢，請根據你的訓練資料給出合理估計，並在note中說明。`;

    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 500,
        tools: [{ type: 'web_search_20250305', name: 'web_search' }],
        messages: [{ role: 'user', content: prompt }]
      })
    });

    showSrchProg(70);
    const data = await resp.json();
    const text = data.content.filter(b => b.type === 'text').map(b => b.text).join('');
    const clean = text.replace(/```json|```/g, '').trim();
    const json = JSON.parse(clean);
    showSrchProg(100);
    return json;
  } catch(e) {
    showSrchProg(0);
    return null;
  }
}

async function scanMultipleStocks(codes, threshold, bigDef) {
  const results = [];
  const total = codes.length;

  for(let i = 0; i < codes.length; i++) {
    const code = codes[i].trim();
    if(!code) continue;
    updateScanStatus(`查詢中 ${code}... (${i+1}/${total})`);
    updateScanProg(Math.round((i/total)*90));

    try {
      const data = await queryStockChip(code, '');
      if(data && data.delta >= threshold) {
        results.push(data);
      }
      // 避免 API 過載
      await delay(800);
    } catch(e) {}
  }

  updateScanProg(100);
  return results;
}

