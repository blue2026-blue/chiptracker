function renderSummary() {
  let strong=0, alert=0, topD=0, topN='—';
  stocks.forEach(s => {
    const sig=getSig(s);
    if(sig.k==='strong') strong++;
    if(sig.k==='alert' || (s.big-s.prev)>=1) alert++;
    const d=s.big-s.prev;
    if(d>topD){ topD=d; topN=s.name; }
  });
  document.getElementById('s-strong').textContent = strong+'檔';
  document.getElementById('s-alert').textContent  = alert+'檔';
  document.getElementById('s-total').textContent  = stocks.length+'檔';
  document.getElementById('s-top').textContent    = topD>0 ? `+${topD.toFixed(2)}%` : '—';

  // Alert banner
  const alerts = stocks.filter(s => (s.big-s.prev)>=1.0);
  const bar = document.getElementById('alertBar');
  if(alerts.length > 0) {
    bar.classList.add('show');
    document.getElementById('alertList').innerHTML = alerts.map(s => {
      const d=(s.big-s.prev).toFixed(2);
      return `<div class="alert-item"><div class="adot"></div><span><b>${s.name}(${s.code})</b> 大戶週增 +${d}%，目前 ${s.big.toFixed(2)}%</span></div>`;
    }).join('');
  } else { bar.classList.remove('show'); }
}

function filterList() {
  const order={strong:0,alert:1,mid:2,watch:3,neutral:4,down:5};
  let list = [...stocks];
  if(filter==='alert') list=list.filter(s=>(s.big-s.prev)>=1.0);
  else if(filter==='strong') list=list.filter(s=>getSig(s).k==='strong');
  else if(filter==='up') list=list.filter(s=>['strong','alert','mid','watch'].includes(getSig(s).k));
  else if(filter==='down') list=list.filter(s=>getSig(s).k==='down');
  return list.sort((a,b)=>(order[getSig(a).k]||9)-(order[getSig(b).k]||9));
}

